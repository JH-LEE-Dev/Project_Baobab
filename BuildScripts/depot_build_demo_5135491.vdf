// ============================================================================
//  LumberBoy Demo — 데모 depot 스크립트
//
//  depot 5135491 ⊂ 앱 5135490
//  제외 규칙은 정식과 동일합니다. 근거는 BuildScripts/README.md 참고.
// ============================================================================

"DepotBuildConfig"
{
	// ⚠ app_build_demo_5135490.vdf 의 depots 항목과 반드시 같은 번호여야 합니다.
	"DepotID"	"5135491"

	"contentroot"	"..\Build\Demo"

	"FileMapping"
	{
		"LocalPath"	"*"
		"DepotPath"	"."
		"recursive"	"1"
	}

	// --- 개발용 파일 -------------------------------------------------------
	"FileExclusion"	"steam_appid.txt"

	// --- 디버그 심볼 -------------------------------------------------------
	// 데모에서 특히 중요합니다. DemoContentStripper가 미공개 에셋을 빼내도,
	// 이 폴더에는 게임 코드가 C++ 소스로 남아 있어 스포일러가 새어 나갈 수 있습니다.
	"FileExclusion"	"*_BackUpThisFolder_ButDontShipItWithYourGame*"
	"FileExclusion"	"*_BurstDebugInformation_DoNotShip*"
	"FileExclusion"	"*.pdb"

	// --- 잡동사니 ----------------------------------------------------------
	"FileExclusion"	"*.log"
	"FileExclusion"	"Thumbs.db"
	"FileExclusion"	"desktop.ini"
}
