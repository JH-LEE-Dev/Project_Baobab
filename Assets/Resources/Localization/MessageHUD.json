    {
      "id": 102,
      "key": "dungeonStateStage1Idle0SubText",
      "kr": "오늘은 날씨가 맑네요!",
      "en": "The weather's lovely today!",
      "enumType": "DungeonState",
      "enumValue": "Stage1_Idle0"
    },
    {
      "id": 103,
      "key": "dungeonStateStage1Idle1SubText",
      "kr": "숲바람이 살랑살랑 불어요.",
      "en": "A gentle breeze is blowing through the forest.",
      "enumType": "DungeonState",
      "enumValue": "Stage1_Idle1"
    },
    {
      "id": 104,
      "key": "dungeonStateStage1Idle2SubText",
      "kr": "숲속 공기가 참 상쾌하네요!",
      "en": "The forest air feels so fresh!",
      "enumType": "DungeonState",
      "enumValue": "Stage1_Idle2"
    },
    {
      "id": 105,
      "key": "dungeonStateStage1Idle3SubText",
      "kr": "오늘도 평화로운 벌목의 하루!",
      "en": "Another peaceful day of logging!",
      "enumType": "DungeonState",
      "enumValue": "Stage1_Idle3"
    },
    {
      "id": 106,
      "key": "dungeonStateStage2Idle0SubText",
      "kr": "말랑한 숲향기가 코끝을 간질여요.",
      "en": "The forest's sweet, earthy scent tickles my nose.",
      "enumType": "DungeonState",
      "enumValue": "Stage2_Idle0"
    },
    {
      "id": 107,
      "key": "dungeonStateStage2Idle1SubText",
      "kr": "발밑에서 푹신한 기운이 느껴집니다.",
      "en": "The ground feels springy underfoot.",
      "enumType": "DungeonState",
      "enumValue": "Stage2_Idle1"
    },
    {
      "id": 108,
      "key": "dungeonStateStage2Idle2SubText",
      "kr": "몽글몽글 피어오르네요!",
      "en": "Puffs of spores are drifting up everywhere!",
      "enumType": "DungeonState",
      "enumValue": "Stage2_Idle2"
    },
    {
      "id": 109,
      "key": "dungeonStateStage3Idle0SubText",
      "kr": "나무뿌리 사이로 별빛이 스며들고 있네요.",
      "en": "Starlight is filtering through the roots.",
      "enumType": "DungeonState",
      "enumValue": "Stage3_Idle0"
    },
    {
      "id": 110,
      "key": "dungeonStateStage3Idle1SubText",
      "kr": "오늘은 별빛이 길을 밝혀주네요.",
      "en": "The starlight is showing me the way today.",
      "enumType": "DungeonState",
      "enumValue": "Stage3_Idle1"
    },
    {
      "id": 111,
      "key": "dungeonStateStage3Idle2SubText",
      "kr": "오늘 숲은 조금 신비로운 표정이에요.",
      "en": "The forest feels a little mysterious today.",
      "enumType": "DungeonState",
      "enumValue": "Stage3_Idle2"
    },
    {
      "id": 112,
      "key": "dungeonStateStage4Idle0SubText",
      "kr": "뜨거운 열기가 숲길 위로 아른거려요.",
      "en": "Heat shimmers above the forest path.",
      "enumType": "DungeonState",
      "enumValue": "Stage4_Idle0"
    },
    {
      "id": 113,
      "key": "dungeonStateStage4Idle1SubText",
      "kr": "발밑이 따끈하니 조심히 걸어야겠어요!",
      "en": "The ground's warm. Better watch my step!",
      "enumType": "DungeonState",
      "enumValue": "Stage4_Idle1"
    },
    {
      "id": 114,
      "key": "dungeonStateStage4Idle2SubText",
      "kr": "용암빛이 나무 그림자를 흔들고있어요.",
      "en": "The lava glow makes the trees' shadows dance.",
      "enumType": "DungeonState",
      "enumValue": "Stage4_Idle2"
    }
  ]
