    {
      "id": 102,
      "key": "dungeonStateStage1Idle0SubText",
      "kr": "오늘은 날씨가 맑네요!",
      "en": "The sky is so clear today!",
      "zhHans": "今天天气真好啊！",
      "zhHant": "今天天氣真好啊！",
      "ja": "今日はいい天気ですね！",
      "de": "Heute ist der Himmel herrlich klar!",
      "fr": "Le ciel est vraiment dégagé aujourd'hui !",
      "pt": "O céu está tão limpo hoje!",
      "es": "¡Qué despejado está el cielo hoy!",
      "ru": "Какое сегодня ясное небо!",
      "pl": "Ale dziś pogodne niebo!",
      "tr": "Bugün hava ne kadar açık!",
      "esLatam": "¡Qué despejado está el cielo hoy!",
      "it": "Che bel cielo sereno oggi!",
      "uk": "Яке сьогодні ясне небо!",
      "cs": "Dnes je krásně jasno!",
      "ind": "Langit cerah sekali hari ini!",
      "vi": "Hôm nay trời trong xanh quá!",
      "th": "",
      "enumType": "DungeonState",
      "enumValue": "Stage1_Idle0"
    },
    {
      "id": 103,
      "key": "dungeonStateStage1Idle1SubText",
      "kr": "숲바람이 살랑살랑 불어요.",
      "en": "A gentle breeze is blowing through the woods.",
      "zhHans": "森林里微风轻轻吹拂。",
      "zhHant": "森林裡微風輕輕吹拂。",
      "ja": "森をそよ風が吹き抜けています。",
      "de": "Eine sanfte Brise weht durch den Wald.",
      "fr": "Une douce brise souffle dans les bois.",
      "pt": "Uma brisa suave sopra pela floresta.",
      "es": "Una suave brisa recorre el bosque.",
      "ru": "По лесу гуляет лёгкий ветерок.",
      "pl": "W lesie wieje lekki wietrzyk.",
      "tr": "Ormanda hafif bir esinti var.",
      "esLatam": "Una brisa suave recorre el bosque.",
      "it": "Una brezza leggera soffia nel bosco.",
      "uk": "Лісом віє легенький вітерець.",
      "cs": "Lesem vane lehký vánek.",
      "ind": "Angin sepoi-sepoi berembus di hutan.",
      "vi": "Gió nhẹ đang lướt qua khu rừng.",
      "th": "",
      "enumType": "DungeonState",
      "enumValue": "Stage1_Idle1"
    },
    {
      "id": 104,
      "key": "dungeonStateStage1Idle2SubText",
      "kr": "숲속 공기가 참 상쾌하네요!",
      "en": "The forest air feels so fresh!",
      "zhHans": "森林里的空气真清新啊！",
      "zhHant": "森林裡的空氣真清新啊！",
      "ja": "森の空気って、すがすがしいですね！",
      "de": "Die Waldluft ist herrlich frisch!",
      "fr": "L'air de la forêt est si vivifiant !",
      "pt": "O ar da floresta está tão fresco!",
      "es": "¡Qué aire tan fresco se respira en el bosque!",
      "ru": "Какой же свежий воздух в лесу!",
      "pl": "Leśne powietrze jest takie rześkie!",
      "tr": "Ormanın havası ne kadar ferah!",
      "esLatam": "¡Qué fresco es el aire del bosque!",
      "it": "L’aria del bosco è così fresca!",
      "uk": "Яке ж свіже лісове повітря!",
      "cs": "Ten lesní vzduch je tak svěží!",
      "ind": "Udara hutan terasa segar sekali!",
      "vi": "Không khí trong rừng thật trong lành!",
      "th": "",
      "enumType": "DungeonState",
      "enumValue": "Stage1_Idle2"
    },
    {
      "id": 105,
      "key": "dungeonStateStage1Idle3SubText",
      "kr": "오늘도 평화로운 벌목의 하루!",
      "en": "Another peaceful day for chopping wood!",
      "zhHans": "今天也是和平伐木的一天！",
      "zhHant": "今天也是和平伐木的一天！",
      "ja": "今日も平和な伐採日和！",
      "de": "Wieder ein ruhiger Tag zum Holzfällen!",
      "fr": "Encore une belle journée paisible pour couper du bois !",
      "pt": "Mais um dia tranquilo para cortar madeira!",
      "es": "¡Otro día tranquilo para talar árboles!",
      "ru": "Ещё один спокойный день за рубкой деревьев!",
      "pl": "Kolejny spokojny dzień przy ścinaniu drzew!",
      "tr": "Ağaç kesmek için yine huzurlu bir gün!",
      "esLatam": "¡Otro día tranquilo para talar árboles!",
      "it": "Un’altra giornata tranquilla per tagliare alberi!",
      "uk": "Ще один спокійний день для рубання дерев!",
      "cs": "Další poklidný den na kácení stromů!",
      "ind": "Hari yang damai untuk menebang pohon lagi!",
      "vi": "Lại một ngày đốn cây thật yên bình!",
      "th": "",
      "enumType": "DungeonState",
      "enumValue": "Stage1_Idle3"
    },
    {
      "id": 106,
      "key": "dungeonStateStage2Idle0SubText",
      "kr": "말랑한 숲향기가 코끝을 간질여요.",
      "en": "A soft, sweet scent tickles my nose.",
      "zhHans": "",
      "zhHant": "",
      "ja": "",
      "de": "",
      "fr": "",
      "pt": "",
      "es": "",
      "ru": "",
      "pl": "Słodkawy zapach lasu łaskocze mnie w nos.",
      "tr": "Ormanın tatlı kokusu burnumu gıdıklıyor.",
      "esLatam": "Un aroma dulce del bosque me hace cosquillas en la nariz.",
      "it": "Un dolce profumo del bosco mi solletica il naso.",
      "uk": "Ніжний солодкий запах лісу лоскоче ніс.",
      "cs": "Jemná sladká vůně lesa mě lechtá v nose.",
      "ind": "Aroma manis hutan menggelitik hidungku.",
      "vi": "Hương rừng dịu ngọt làm nhột mũi.",
      "th": "",
      "enumType": "DungeonState",
      "enumValue": "Stage2_Idle0"
    },
    {
      "id": 107,
      "key": "dungeonStateStage2Idle1SubText",
      "kr": "발밑에서 푹신한 기운이 느껴집니다.",
      "en": "The ground feels squishy underfoot.",
      "zhHans": "",
      "zhHant": "",
      "ja": "",
      "de": "",
      "fr": "",
      "pt": "",
      "es": "",
      "ru": "",
      "pl": "Miękko tu pod stopami.",
      "tr": "Ayaklarımın altındaki zemin yumuşacık.",
      "esLatam": "El suelo se siente blandito bajo mis pies.",
      "it": "Il terreno è morbido sotto i piedi.",
      "uk": "Земля під ногами така м’яка.",
      "cs": "Země pod nohama je tak měkká.",
      "ind": "Tanahnya terasa empuk di bawah kaki.",
      "vi": "Mặt đất dưới chân mềm thật.",
      "th": "",
      "enumType": "DungeonState",
      "enumValue": "Stage2_Idle1"
    },
    {
      "id": 108,
      "key": "dungeonStateStage2Idle2SubText",
      "kr": "몽글몽글 피어오르네요!",
      "en": "Spores are puffing up everywhere!",
      "zhHans": "",
      "zhHant": "",
      "ja": "",
      "de": "",
      "fr": "",
      "pt": "",
      "es": "",
      "ru": "",
